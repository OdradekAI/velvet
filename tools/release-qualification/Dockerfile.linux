FROM rust:1.90-bookworm

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      libwebkit2gtk-4.1-dev \
      build-essential \
      curl \
      wget \
      file \
      libxdo-dev \
      libssl-dev \
      libdbus-1-dev \
      libappindicator3-dev \
      librsvg2-dev \
      pkg-config \
      patchelf \
      xdg-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
ENTRYPOINT ["bash"]

{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@site/*": ["./*"],
      "@velvet-ui": ["../desktop/src/app/ui/index.ts"]
    }
  },
  "include": [
    "docusaurus.config.ts",
    "sidebars.ts",
    "sidebars-reference.ts",
    "src/**/*"
  ]
}

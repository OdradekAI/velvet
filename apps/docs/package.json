{
  "name": "@velvet/docs",
  "private": true,
  "version": "0.0.6",
  "scripts": {
    "start": "docusaurus start",
    "start:clean": "docusaurus clear && docusaurus start",
    "start:all": "docusaurus build && docusaurus serve",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "serve:all": "docusaurus build && docusaurus serve",
    "clear": "docusaurus clear",
    "check:docs": "node tools/check-docs.mjs",
    "check:links": "node tools/check-docs.mjs --links-only",
    "check:source-link": "node tools/check-docs.mjs --source-link-only",
    "verify:release": "npm run check:docs && npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "serialize-javascript": "7.1.4",
    "sockjs": {
      "uuid": "11.1.1"
    },
    "tinypool": "2.2.0"
  }
}

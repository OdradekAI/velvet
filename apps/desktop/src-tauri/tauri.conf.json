{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velvet",
  "version": "0.0.4",
  "identifier": "com.velvet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Velvet",
        "width": 1440,
        "height": 900,
        "minWidth": 920,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
